[Unit]
Description=Join the Wi-Fi network from wifi.txt and install SSH keys from authorized_keys on the boot partition
After=NetworkManager.service boot-firmware.mount firstboot.service
Wants=NetworkManager.service

[Service]
Type=oneshot
ExecStartPre=-/usr/local/sbin/mdeck-ssh-import
ExecStart=/usr/local/sbin/mdeck-wifi-import

[Install]
WantedBy=multi-user.target
