# background 1: the panel
rounded = 0
border_width = 0
background_color = #1b2430 100
border_color = #1b2430 100

# background 2: a task
rounded = 2
border_width = 0
background_color = #2c3b52 100
border_color = #2c3b52 100

# background 3: the active task
rounded = 2
border_width = 0
background_color = #f0b030 100
border_color = #f0b030 100

panel_items = PTSEEC
panel_size = 100% 26
panel_position = top center horizontal
panel_layer = top
panel_background_id = 1
panel_padding = 2 1 2
strut_policy = follow_size
taskbar_mode = single_desktop
taskbar_background_id = 0
task_text = 1
task_maximum_size = 140 22
task_padding = 4 2 4
task_font = DejaVu Sans 8
task_font_color = #f0f0f0 100
task_active_font_color = #101010 100
task_background_id = 2
task_active_background_id = 3
time1_format = %H:%M
time1_font = DejaVu Sans 9
clock_font_color = #f0f0f0 100
clock_padding = 4 0
systray_padding = 2 1 2

button = new
button_text = Steam
button_font = DejaVu Sans 8
button_font_color = #f0f0f0 100
button_background_id = 2
button_padding = 6 2 4
button_lclick_command = /usr/local/bin/steamos-session-select gamescope

execp = new
execp_command = cat ${XDG_RUNTIME_DIR}/mdeck-pad-mode 2>/dev/null
execp_interval = 1
execp_font = DejaVu Sans Bold 8
execp_font_color = #f0b030 100
execp_padding = 6 2 4

execp = new
execp_command = echo "$(cat /sys/class/power_supply/battery/capacity)%"
execp_interval = 30
execp_font = DejaVu Sans 8
execp_font_color = #f0f0f0 100
execp_padding = 6 2 4
