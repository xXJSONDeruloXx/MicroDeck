#!/bin/sh
# Recompresses zram pages that have gone unused with the stronger secondary algorithm (zstd) while the fast primary
# (lzo-rle) handles everything live: capacity of the slow algorithm, the stalls of the fast one. Every INTERVAL seconds:
# mark all pages idle, wait, then recompress those still idle (a touched page loses its idle mark).
# Needs a secondary algorithm configured in /etc/systemd/zram-generator.conf (compression-algorithm = lzo-rle zstd).
INTERVAL=${INTERVAL:-60}
Z=/sys/block/zram0
[ -w $Z/recompress ] || { echo "mdeck-zram-recompress: no recompress support"; exit 1; }
while :; do
  echo all > $Z/idle
  sleep "$INTERVAL"
  echo "type=idle algo=zstd" > $Z/recompress 2>/dev/null
done
