#!/bin/sh
# Sleep (s2idle) control and test.
#   mdeck-sleep status        is it on, which RTC can wake the handheld, which wake sources are armed
#   mdeck-sleep on | off      remove or create the "nosleep" file on the boot partition (effective at once); sleep is on by default
#   mdeck-sleep test [secs]   sleep through the real path (systemd, hooks) with an RTC alarm [60 s] as the fallback; press the power button
#                           within that time. Prints what woke the handheld: "power-button" means it works, "rtc" means only the alarm did.
FLAG=/boot/firmware/nosleep

rtc() {  # the SoC's own RTC (its interrupt reaches the wake path); the I2C chip on some boards (pcf8563) has no wired alarm line
  for r in /sys/class/rtc/rtc*; do
    case "$(cat "$r/name" 2>/dev/null)" in sun6i-rtc*|*7000000.rtc*) echo "$r"; return ;; esac
  done
}

count() {  # active_count of a wakeup source by name
  for w in /sys/class/wakeup/wakeup*; do
    [ "$(cat "$w/name" 2>/dev/null)" = "$1" ] && { cat "$w/active_count"; return; }
  done
  echo 0
}

apply() {
  /usr/local/sbin/mdeck-sleep-config
  systemctl kill -s HUP systemd-logind 2>/dev/null
}

case "${1:-status}" in
  status)
    [ -f "$FLAG" ] && echo "sleep: off ($FLAG exists; run: mdeck-sleep on)" || echo "sleep: on (touch $FLAG or run: mdeck-sleep off to disable)"
    echo "mem_sleep: $(cat /sys/power/mem_sleep)"
    echo "wake RTC: $(rtc)"
    for w in /sys/class/wakeup/wakeup*; do echo "wake source $(cat "$w/name"): woke $(cat "$w/active_count") times"; done
    ;;
  on)  rm -f "$FLAG" && sync && apply && echo "sleep is on: the power button's short press sleeps, a long press powers off" ;;
  off) touch "$FLAG" && sync && apply && echo "sleep is off" ;;
  test)
    secs=${2:-60}
    [ -f "$FLAG" ] && { echo "sleep is off: run 'mdeck-sleep on' first"; exit 1; }
    r=$(rtc); [ -n "$r" ] || { echo "no SoC RTC found"; exit 1; }
    rtc_before=$(count 7000000.rtc); pek_before=$(count axp20x-pek)
    echo 0 > "$r/wakealarm"; echo "+$secs" > "$r/wakealarm"
    rm -f /run/mdeck-sleep-woke
    echo "sleeping now; press the power button within $secs s (the RTC alarm is the fallback)"
    systemctl suspend
    i=0; while [ ! -f /run/mdeck-sleep-woke ] && [ "$i" -lt $((secs + 90)) ]; do sleep 1; i=$((i + 1)); done
    rtc_after=$(count 7000000.rtc); pek_after=$(count axp20x-pek)
    echo 0 > "$r/wakealarm"
    if [ "$pek_after" -gt "$pek_before" ]; then src=power-button
    elif [ "$rtc_after" -gt "$rtc_before" ]; then src=rtc
    else src=unknown; fi
    echo "woke up; source: $src (power-button $pek_before->$pek_after, rtc $rtc_before->$rtc_after)"
    echo "$(date -u +%FT%TZ) test ${secs}s: $src" >> /home/sleep-test.log
    ;;
  *) echo "usage: mdeck-sleep status|on|off|test [secs]"; exit 2 ;;
esac
