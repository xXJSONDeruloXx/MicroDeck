#!/usr/bin/python3
"""Battery guard: a clean shutdown before the battery dies, and less power draw when it is low.

On battery (not charging):
  <= LOW %        cap the CPU at SAVER_KHZ (the cap is lifted when charging or above LOW + 5 %)
  <= SHUTDOWN %   sync and power off, so the SD card is never cut in the middle of a write
Steam's own UI only shows the level. Polls every INTERVAL seconds; paths can be overridden for tests.
"""
import glob
import os
import subprocess
import sys
import time

POWER = os.environ.get("SXX_BATTERY_DIR", "/sys/class/power_supply/battery")
CPUFREQ = os.environ.get("SXX_CPUFREQ_DIR", "/sys/devices/system/cpu/cpufreq")
LOW = int(os.environ.get("SXX_BATTERY_LOW", "15"))
SHUTDOWN = int(os.environ.get("SXX_BATTERY_SHUTDOWN", "5"))
SAVER_KHZ = int(os.environ.get("SXX_BATTERY_SAVER_KHZ", "1008000"))
INTERVAL = int(os.environ.get("SXX_BATTERY_INTERVAL", "30"))


def read(name):
    try:
        with open(os.path.join(POWER, name)) as f:
            return f.read().strip()
    except OSError:
        return None


def decide(status, capacity, capped):
    """('poweroff' | 'cap' | 'uncap' | None) from the battery state."""
    if status is None or capacity is None:
        return None
    discharging = status == "Discharging"
    if discharging and capacity <= SHUTDOWN:
        return "poweroff"
    if discharging and capacity <= LOW and not capped:
        return "cap"
    if capped and (not discharging or capacity > LOW + 5):
        return "uncap"
    return None


def set_cap(khz):
    """khz=None restores each policy's maximum."""
    for policy in glob.glob(os.path.join(CPUFREQ, "policy*")):
        target = khz
        if target is None:
            try:
                with open(os.path.join(policy, "cpuinfo_max_freq")) as f:
                    target = int(f.read())
            except (OSError, ValueError):
                continue
        try:
            with open(os.path.join(policy, "scaling_max_freq"), "w") as f:
                f.write(str(target))
        except OSError:
            pass


def main():
    capped = False
    while True:
        cap = read("capacity")
        action = decide(read("status"), int(cap) if cap and cap.isdigit() else None, capped)
        if action == "cap":
            set_cap(SAVER_KHZ)
            capped = True
            print("sxx-battery: battery low, CPU capped at %d kHz" % SAVER_KHZ, flush=True)
        elif action == "uncap":
            set_cap(None)
            capped = False
            print("sxx-battery: CPU cap lifted", flush=True)
        elif action == "poweroff":
            print("sxx-battery: battery at %s %%, powering off" % cap, flush=True)
            subprocess.run(["sync"])
            subprocess.run(["systemctl", "poweroff"])
            time.sleep(120)
        time.sleep(INTERVAL)


if __name__ == "__main__":
    sys.exit(main())
