#!/bin/sh
# Marks the running release good once Steam's UI has stayed up for 30 s (the initramfs rolls an update back after three boots
# that never get here). Nothing to do when no update is on trial.
/usr/local/sbin/mdeck-update reconcile 2>/dev/null
[ -f /home/.mdeck/update/trial ] || exit 0
ok=0
for i in $(seq 1 120); do
  if mdeck eval 'location.pathname' 2>/dev/null | grep -q '^/routes/'; then ok=$((ok + 1)); else ok=0; fi
  [ $ok -ge 6 ] && break
  sleep 5
done
[ $ok -ge 6 ] && /usr/local/sbin/mdeck-update good
exit 0
