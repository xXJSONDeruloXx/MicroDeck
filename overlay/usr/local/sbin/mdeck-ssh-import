#!/bin/sh
# Installs the public keys in authorized_keys on the boot partition (FAT, writable from any PC) for root and the steam
# user, so SSH works without adb. One key per line, as in ~/.ssh/authorized_keys. Runs at every boot (from
# mdeck-wifi-import.service) and imports again when the file changes.
f=/boot/firmware/authorized_keys
state=/var/lib/mdeck/ssh.sha
# A copy lives on the data partition, so a reflash keeps the keys.
mirror=/home/.mdeck
[ -f "$f" ] && { mkdir -p "$mirror" && install -m 600 "$f" "$mirror/authorized_keys"; }
[ -f "$f" ] || f=$mirror/authorized_keys
[ -f "$f" ] || exit 0
sum=$(sha256sum "$f" | cut -d' ' -f1)
# the checksum alone is not enough: an installed key file that is empty or missing (a copied or interrupted root) is imported again
[ "$(cat "$state" 2>/dev/null)" = "$sum" ] && [ -s /root/.ssh/authorized_keys ] && exit 0
keys=$(mktemp)
tr -d '\r' < "$f" | grep -E '^(ssh-|ecdsa-|sk-)' > "$keys"
[ -s "$keys" ] || { echo "mdeck-ssh-import: no public keys in $f"; rm -f "$keys"; exit 1; }
for home in /root /home/steam; do
  install -d -m 700 "$home/.ssh"
  install -m 600 "$keys" "$home/.ssh/authorized_keys"
done
chown -R steam:steam /home/steam/.ssh
rm -f "$keys"
mkdir -p /var/lib/mdeck && echo "$sum" > "$state"
echo "mdeck-ssh-import: installed $(tr -d '\r' < "$f" | grep -cE '^(ssh-|ecdsa-|sk-)') key(s)"
