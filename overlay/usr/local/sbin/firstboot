#!/bin/sh
# One-time setup on the device: the data partition for /home, new SSH host keys.
#
# The image holds boot (p1) and a fixed-size root (p2). Everything the user accumulates (Steam, Proton, games,
# prefixes, the Steam login) lives in /home on a third partition, "sxxdata", that starts right after the root and runs
# to the end of the card. Writing a new image to the card only rewrites p1 and p2, so the data is still there: when the
# partition table has no p3 but an ext4 filesystem labelled sxxdata sits at that offset, the partition entry is put back
# instead of formatting. A card without one gets a new data partition, seeded with the image's /home.
set -x
root=$(findmnt -no SOURCE /)
disk=/dev/$(lsblk -no PKNAME "$root")
rootpart=${root##*/}
# mmcblk0 and nvme0n1 name their partitions disk+"p"+N, vda and sda disk+N (the QEMU virtual device is vda)
case "$disk" in *[0-9]) data=${disk}p3 ;; *) data=${disk}3 ;; esac

if [ ! -b "$data" ]; then
  set -- $(sfdisk -d "$disk" | sed -n "s/.*${rootpart} : start= *\([0-9]*\), size= *\([0-9]*\).*/\1 \2/p")
  start=$(( $1 + $2 ))
  total=$(( $(blockdev --getsz "$disk") ))
  if [ "$start" -gt 0 ] && [ $(( total - start )) -gt 2097152 ]; then
    found=no
    if blkid -p -O $(( start * 512 )) -o export "$disk" 2>/dev/null | grep -qx 'LABEL=sxxdata'; then
      blkid -p -O $(( start * 512 )) -o export "$disk" | grep -qx 'TYPE=ext4' && found=yes
    fi
    echo "start=$start, type=83" | sfdisk --append --no-reread -q "$disk"
    partx -u "$disk" 2>/dev/null || partprobe "$disk" 2>/dev/null
    # the node appears when udev has processed the new partition, which is slow on a busy or emulated system
    udevadm settle --timeout=20 2>/dev/null
    for i in $(seq 1 40); do [ -b "$data" ] && break; sleep 1; done
    if [ -b "$data" ]; then
      if [ "$found" = yes ]; then
        # the old filesystem may be smaller than a bigger card's partition: grow it to fit
        e2fsck -p -f "$data" ; resize2fs "$data" || true
        echo "firstboot: reusing the existing data partition"
      else
        mkfs.ext4 -F -q -L sxxdata -m 1 "$data" && {
          mkdir -p /mnt/sxxdata && mount "$data" /mnt/sxxdata && cp -a /home/. /mnt/sxxdata/ && umount /mnt/sxxdata
        }
        echo "firstboot: created a new data partition"
      fi
      mount /home || mount "$data" /home
    fi
  fi
fi

# host keys live on the data partition too, so an OS update does not change the device's SSH identity
hk=/home/.sxx/ssh-host-keys
if ls $hk/ssh_host_* >/dev/null 2>&1; then
  cp -a $hk/ssh_host_* /etc/ssh/
else
  ssh-keygen -A
  mkdir -p $hk && chmod 700 /home/.sxx $hk && cp -a /etc/ssh/ssh_host_* $hk/
fi
mkdir -p /var/log/journal && systemd-tmpfiles --create --prefix /var/log/journal
touch /var/lib/firstboot.done
