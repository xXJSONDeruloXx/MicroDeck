#!/bin/sh
# Checks the memory safety net: grows a process named like a Wine process until something kills it,
# then reports who did (earlyoom or the kernel) and whether sshd kept answering meanwhile.
#   mdeck-memhog            run as the steam user, from adb or ssh
start=$(date +%s)
python3 -c '
import ctypes, os, time
ctypes.CDLL(None).prctl(15, b"wine64-preloader", 0, 0, 0)
blocks = []
while True:
    blocks.append(os.urandom(16 << 20))
    time.sleep(0.05)
' &
hog=$!
worst=0
while kill -0 $hog 2>/dev/null; do
  t0=$(date +%s%N)
  timeout 30 ssh-keyscan -T 25 127.0.0.1 >/dev/null 2>&1 || echo "mdeck-memhog: sshd did not answer"
  ms=$(( ($(date +%s%N) - t0) / 1000000 )); [ $ms -gt $worst ] && worst=$ms
  sleep 1
done
echo "mdeck-memhog: hog gone after $(( $(date +%s) - start )) s, slowest sshd banner ${worst} ms"
journalctl -u earlyoom --since "@$start" --no-pager -o cat | grep -iE "sending|killed" | tail -2
dmesg | grep -iE "killed process|out of memory" | tail -2
