#!/usr/bin/python3
"""MicroDeck automation: drive and inspect the Steam session without touching the device.

  mdeck targets                      list Steam's DevTools targets (needs CDP_PORT in steam-session.conf)
  mdeck eval [-t TARGET] JS          evaluate JS in a target (default SharedJSContext), print the value
  mdeck pad TOKEN...                 press buttons on the virtual test pad (mdeck-vpad.service):
                                   a b x y up down left right lb rb lt rt start select guide ls rs,
                                   hold:BTN:MS, wait:MS, stick:L|R:X:Y (-1..1, released after 200 ms)
  mdeck vpad-daemon                  the virtual pad itself (run as root by mdeck-vpad.service)
  mdeck ui-fixes                     keeps small fixes applied inside Steam's UI pages (mdeck-ui-fixes.service)

The DevTools WebSocket client and CDP evaluation are adapted from DroidDeck's droiddeck-agent.
"""
import base64
import fcntl
import json
import os
import shutil
import socket
import struct
import subprocess
import sys
import time
import urllib.parse
import urllib.request

CONF = "/etc/steam-session.conf"
VPAD_SOCK = "/run/mdeck-vpad.sock"
CAP = 4 * 1024 * 1024


def conf(key, default=""):
    try:
        for line in open(CONF):
            k, _, v = line.strip().partition("=")
            if k == key:
                return v.strip().strip('"')
    except OSError:
        pass
    return default


# --- DevTools ---------------------------------------------------------------------------------

class WebSocket:
    def __init__(self, url, timeout):
        t = urllib.parse.urlsplit(url)
        if t.scheme != "ws" or t.hostname not in ("127.0.0.1", "localhost"):
            raise SystemExit("mdeck: DevTools targets must be loopback WebSockets")
        path = (t.path or "/") + ("?" + t.query if t.query else "")
        self.s = socket.create_connection(("127.0.0.1", t.port or 80), timeout=timeout)
        key = base64.b64encode(os.urandom(16)).decode()
        self.s.sendall(("GET %s HTTP/1.1\r\nHost: %s\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
                        "Sec-WebSocket-Key: %s\r\nSec-WebSocket-Version: 13\r\n\r\n" % (path, t.netloc, key)).encode())
        head = b""
        while b"\r\n\r\n" not in head:
            chunk = self.s.recv(4096)
            if not chunk:
                raise OSError("DevTools closed the connection during the handshake")
            head += chunk
        if b" 101 " not in head.split(b"\r\n", 1)[0]:
            raise OSError("DevTools refused the WebSocket")
        self.buf = head.split(b"\r\n\r\n", 1)[1]

    def _read(self, n):
        while len(self.buf) < n:
            chunk = self.s.recv(65536)
            if not chunk:
                raise OSError("DevTools closed the connection")
            self.buf += chunk
        data, self.buf = self.buf[:n], self.buf[n:]
        return data

    def send(self, text):
        payload = text.encode()
        header = bytearray([0x81])
        n = len(payload)
        if n < 126:
            header.append(0x80 | n)
        elif n < 65536:
            header += bytes([0x80 | 126]) + struct.pack(">H", n)
        else:
            header += bytes([0x80 | 127]) + struct.pack(">Q", n)
        mask = os.urandom(4)
        self.s.sendall(bytes(header) + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(payload)))

    def recv(self):
        msg = b""
        while True:
            b0, b1 = self._read(2)
            n = b1 & 0x7F
            if n == 126:
                n = struct.unpack(">H", self._read(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", self._read(8))[0]
            if len(msg) + n > CAP:
                raise OSError("DevTools response too large")
            mask = self._read(4) if b1 & 0x80 else None
            data = self._read(n)
            if mask:
                data = bytes(b ^ mask[i % 4] for i, b in enumerate(data))
            op = b0 & 0x0F
            if op == 8:
                raise OSError("DevTools closed the WebSocket")
            if op in (0, 1, 2):
                msg += data
                if b0 & 0x80:
                    return msg.decode(errors="replace")


def targets():
    port = conf("CDP_PORT")
    if not port.isdigit():
        raise SystemExit("mdeck: CDP_PORT is not set in " + CONF)
    with urllib.request.urlopen("http://127.0.0.1:%s/json" % port, timeout=5) as r:
        return json.loads(r.read().decode())


def cdp_eval(expression, want="SharedJSContext", timeout=20):
    match = [t for t in targets() if t.get("webSocketDebuggerUrl")
             and (want in (t.get("title") or "") or want in (t.get("url") or ""))]
    if not match:
        raise SystemExit("mdeck: no DevTools target matches %r" % want)
    ws = WebSocket(match[0]["webSocketDebuggerUrl"], timeout)
    try:
        ws.send(json.dumps({"id": 1, "method": "Runtime.evaluate", "params": {
            "expression": expression, "returnByValue": True, "awaitPromise": True, "userGesture": True}}))
        while True:
            m = json.loads(ws.recv())
            if m.get("id") != 1:
                continue
            if "error" in m:
                raise SystemExit("mdeck: CDP error: " + json.dumps(m["error"]))
            res = m.get("result", {})
            if res.get("exceptionDetails"):
                d = res["exceptionDetails"]
                raise SystemExit("mdeck: JS exception: " + ((d.get("exception") or {}).get("description") or d.get("text")))
            return res.get("result", {}).get("value")
    finally:
        ws.s.close()


# --- fixes inside Steam's UI pages ------------------------------------------------------------

# Chromium draws a gray "cast" button over every <video> that can cast, and Steam's launch screen plays one (the controller
# diagram), so it sat on top of the diagram. The attribute switches that button off; --disable-blink-features=RemotePlayback
# does not, and Steam owns the <video> elements, so the attribute is set on each one as it is added (the content attribute itself:
# setting the disableRemotePlayback property alone leaves the button).
UI_FIXES_JS = """(function(){
  if (window.__mdeckUiFixes) return;
  window.__mdeckUiFixes = 1;
  function fix(n) {
    if (n.nodeType !== 1) return;
    if (n.tagName === "VIDEO") n.setAttribute("disableremoteplayback", "");
    else if (n.querySelectorAll) n.querySelectorAll("video").forEach(function (v) { v.setAttribute("disableremoteplayback", ""); });
  }
  new MutationObserver(function (ms) {
    for (var i = 0; i < ms.length; i++) for (var j = 0; j < ms[i].addedNodes.length; j++) fix(ms[i].addedNodes[j]);
  }).observe(document, {childList: true, subtree: true});
  document.querySelectorAll("video").forEach(fix);
})()"""

# Steam's UI blurs backgrounds and panels (CSS filter and backdrop-filter), which a software renderer on four A53 cores pays for in every
# frame: the library home page sat at about 190 % CPU with nobody touching it and rendered about 5 frames per second; without the blur
# it idles near 10 % and renders 56 (measured on the RG40XX-H). UI_BLUR=1 in /etc/steam-session.conf keeps Valve's look.
UI_PERF_CSS = "*,*::before,*::after{backdrop-filter:none !important;-webkit-backdrop-filter:none !important;filter:none !important}"
UI_PERF_JS = """;(function(){
  if (window.__mdeckUiPerf) return;
  window.__mdeckUiPerf = 1;
  function add() {
    if (document.getElementById("mdeck-perf")) return;
    var s = document.createElement("style");
    s.id = "mdeck-perf";
    s.textContent = %s;
    (document.head || document.documentElement).appendChild(s);
  }
  add();
  document.addEventListener("DOMContentLoaded", add);
})()""" % json.dumps(UI_PERF_CSS)


def ui_fixes_session(target):
    """One DevTools connection per page: scripts registered for new documents last only as long as it stays open."""
    ws = WebSocket(target["webSocketDebuggerUrl"], 30)
    source = UI_FIXES_JS + ("" if conf("UI_BLUR") == "1" else UI_PERF_JS)
    try:
        ws.send(json.dumps({"id": 1, "method": "Page.addScriptToEvaluateOnNewDocument", "params": {"source": source}}))
        ws.send(json.dumps({"id": 2, "method": "Runtime.evaluate", "params": {"expression": source}}))
        ws.s.settimeout(None)
        while True:
            ws.recv()
    finally:
        ws.s.close()


def ui_fixes():
    import threading
    if not conf("CDP_PORT").isdigit():
        return
    active = set()

    def run(t):
        try:
            ui_fixes_session(t)
        except (OSError, ValueError):
            pass
        finally:
            active.discard(t["id"])

    while True:
        try:
            for t in targets():
                if t.get("webSocketDebuggerUrl") and t.get("type") == "page" and t["id"] not in active:
                    active.add(t["id"])
                    threading.Thread(target=run, args=(t,), daemon=True).start()
        except (OSError, ValueError, SystemExit):
            pass
        time.sleep(3)


# --- virtual test pad -------------------------------------------------------------------------

EV_SYN, EV_KEY, EV_ABS = 0, 1, 3
BUTTONS = {"a": 0x130, "b": 0x131, "x": 0x133, "y": 0x134, "lb": 0x136, "rb": 0x137, "lt": 0x138, "rt": 0x139,
           "select": 0x13a, "start": 0x13b, "guide": 0x13c, "ls": 0x13d, "rs": 0x13e,
           "up": 0x220, "down": 0x221, "left": 0x222, "right": 0x223}
AXES = {"L": (0x00, 0x01), "R": (0x03, 0x04)}
UI_SET_EVBIT, UI_SET_KEYBIT, UI_SET_ABSBIT = 0x40045564, 0x40045565, 0x40045567
UI_DEV_SETUP, UI_ABS_SETUP, UI_DEV_CREATE = 0x405c5503, 0x401c5504, 0x5501
EVENT = struct.Struct("llHHi")


def vpad_daemon():
    fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
    fcntl.ioctl(fd, UI_SET_EVBIT, EV_KEY)
    for code in BUTTONS.values():
        fcntl.ioctl(fd, UI_SET_KEYBIT, code)
    fcntl.ioctl(fd, UI_SET_EVBIT, EV_ABS)
    for code in (0x00, 0x01, 0x03, 0x04):
        fcntl.ioctl(fd, UI_SET_ABSBIT, code)
        # struct uinput_abs_setup: code, then input_absinfo (value, min, max, fuzz, flat, resolution)
        fcntl.ioctl(fd, UI_ABS_SETUP, struct.pack("H2xiiiiii", code, 0, -32768, 32767, 16, 128, 0))
    name = b"MicroDeck Test Pad"
    ident = (0x03, 0x1209, 0x5a5a, 1)
    if os.environ.get("VPAD_IDENTITY") == "h700":
        # Stand in for the built-in pad (unload rocknix_singleadc_joypad first) so presses travel the real path:
        # evdev -> InputPlumber -> virtual Steam Deck controller -> Steam.
        name, ident = b"H700 Gamepad", (0x19, 0x484b, 0x14df, 0x100)
        fcntl.ioctl(fd, 0x4008556c, b"rocknix-singleadc-joypad/input0")  # UI_SET_PHYS
    # struct uinput_setup: input_id (bus, vendor, product, version), name[80], ff_effects_max
    fcntl.ioctl(fd, UI_DEV_SETUP, struct.pack("HHHH80sI", *ident, name, 0))
    fcntl.ioctl(fd, UI_DEV_CREATE)

    def emit(typ, code, val):
        os.write(fd, EVENT.pack(0, 0, typ, code, val))
        os.write(fd, EVENT.pack(0, 0, EV_SYN, 0, 0))

    try:
        os.unlink(VPAD_SOCK)
    except FileNotFoundError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    srv.bind(VPAD_SOCK)
    os.chmod(VPAD_SOCK, 0o666)
    print("mdeck-vpad: ready", flush=True)
    while True:
        for tok in srv.recv(4096).decode().split():
            parts = tok.split(":")
            if parts[0] == "wait":
                time.sleep(int(parts[1]) / 1000)
            elif parts[0] == "stick":
                ax, ay = AXES[parts[1].upper()]
                emit(EV_ABS, ax, int(float(parts[2]) * 32767))
                emit(EV_ABS, ay, int(float(parts[3]) * 32767))
                time.sleep(0.2)
                emit(EV_ABS, ax, 0)
                emit(EV_ABS, ay, 0)
            else:
                ms = int(parts[2]) if parts[0] == "hold" else 80
                btn = parts[1] if parts[0] == "hold" else parts[0]
                code = BUTTONS.get(btn)
                if code is None:
                    print("mdeck-vpad: unknown button %r" % btn, flush=True)
                    continue
                emit(EV_KEY, code, 1)
                time.sleep(ms / 1000)
                emit(EV_KEY, code, 0)
                time.sleep(0.12)


IP_BUTTONS = {"a": "South", "b": "East", "x": "West", "y": "North", "lb": "LeftBumper", "rb": "RightBumper",
              "start": "Start", "select": "Select", "guide": "Guide", "ls": "LeftStick", "rs": "RightStick",
              "up": "DPadUp", "down": "DPadDown", "left": "DPadLeft", "right": "DPadRight"}
IP_CALL = ["busctl", "call", "org.shadowblip.InputPlumber", "/org/shadowblip/InputPlumber/CompositeDevice0",
           "org.shadowblip.Input.CompositeDevice", "SendEvent", "sv"]


def ip_press(button, ms):
    """One press through InputPlumber's composite device, the path the built-in pad takes to Steam's Deck controller."""
    for down in ("true", "false"):
        r = subprocess.run(IP_CALL + ["Gamepad:Button:" + IP_BUTTONS[button], "b", down], capture_output=True)
        if r.returncode:
            return False
        if down == "true":
            time.sleep(ms / 1000)
    time.sleep(0.12)
    return True


def ip_stick(side, x, y):
    """A stick position through InputPlumber (an array of two doubles; other value types are silently ignored)."""
    name = "LeftStick" if side.upper() == "L" else "RightStick"
    r = subprocess.run(IP_CALL + ["Gamepad:Axis:" + name, "ad", "2", str(x), str(y)], capture_output=True)
    return r.returncode == 0


def pad(tokens):
    # Buttons go through InputPlumber when it runs (the real controller path); sticks, triggers and a missing
    # InputPlumber use the uinput test pad.
    rest = []
    for tok in tokens:
        parts = tok.split(":")
        if parts[0] == "wait":
            time.sleep(int(parts[1]) / 1000)
            continue
        if parts[0] == "stick" and len(parts) == 4 and shutil.which("busctl"):
            if ip_stick(parts[1], parts[2], parts[3]):
                time.sleep(0.2)
                ip_stick(parts[1], 0, 0)
                continue
        btn, ms = (parts[1], int(parts[2])) if parts[0] == "hold" else (parts[0], 80)
        if btn in IP_BUTTONS and shutil.which("busctl") and ip_press(btn, ms):
            continue
        rest.append(tok)
    if rest:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        s.sendto(" ".join(rest).encode(), VPAD_SOCK)


def main(argv):
    if len(argv) < 2:
        raise SystemExit(__doc__)
    cmd, args = argv[1], argv[2:]
    if cmd == "targets":
        for t in targets():
            print("%-10s %-40s %s" % (t.get("type"), (t.get("title") or "")[:40], (t.get("url") or "")[:80]))
    elif cmd == "eval":
        want = "SharedJSContext"
        if args[:1] == ["-t"]:
            want, args = args[1], args[2:]
        v = cdp_eval(" ".join(args), want)
        print(v if isinstance(v, str) else json.dumps(v, indent=1))
    elif cmd == "pad":
        pad(args)
    elif cmd == "vpad-daemon":
        vpad_daemon()
    elif cmd == "ui-fixes":
        ui_fixes()
    else:
        raise SystemExit(__doc__)


if __name__ == "__main__":
    main(sys.argv)
