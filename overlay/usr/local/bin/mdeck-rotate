#!/bin/sh
# The RG28XX's panel is 480x640 portrait, mounted sideways, and X draws on its native mode. The kernel reports the mounting
# as the connector's "panel orientation" (from the device tree's rotation); turn the output to match so the session is
# 640x480 landscape like every other handheld. PANEL_ROTATE in /etc/steam-session.conf (normal, left, right, inverted) overrides.
. /etc/steam-session.conf 2>/dev/null
q=$(xrandr --query --prop)
out=$(echo "$q" | awk '/ connected/ {print $1; exit}')
size=$(echo "$q" | grep ' connected' | head -1 | grep -o '[0-9]\+x[0-9]\++' | head -1 | tr -d +)
w=${size%x*} h=${size#*x}
[ -n "$out" ] && [ -n "$w" ] || exit 0
rot=${PANEL_ROTATE:-}
if [ -z "$rot" ]; then
  case $(echo "$q" | grep -i 'panel orientation' | head -1) in
    *"Left Side Up"*) rot=left ;;
    *"Right Side Up"*) rot=right ;;
    *"Upside Down"*) rot=inverted ;;
    *) [ "$h" -gt "$w" ] && rot=left ;;
  esac
fi
[ -n "$rot" ] && xrandr --output "$out" --rotate "$rot"
