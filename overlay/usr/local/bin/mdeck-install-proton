#!/bin/bash
# Installs the pinned ARMv8.0 Proton into Steam's compatibilitytools.d (as the steam user, Steam stopped).
# Valve's Proton uses LSE atomics, which the Cortex-A53 lacks; this build avoids them. No-op when present.
# Prints "@@ <percent> <text>" progress lines for the setup window. Gives up after three failed downloads
# (or with no network) so Steam still starts; the next start tries again.
set -eu
. /usr/local/share/mdeck/proton-armv8.conf
dest=$HOME/.local/share/Steam/compatibilitytools.d
[ -f "$dest/$PROTON_NAME/proton" ] && exit 0
file=$HOME/.cache/$PROTON_NAME.tar.zst
mkdir -p "$dest" "$HOME/.cache"
url=https://github.com/sunshineinabox/proton-armv8/releases/download/$PROTON_TAG/$PROTON_NAME.tar.zst
echo "@@ 58 Downloading Proton"
for attempt in 1 2 3; do
  echo "$PROTON_SHA256  $file" | sha256sum -c --quiet 2>/dev/null && break
  curl -fsI --max-time 15 https://github.com -o /dev/null || { echo "no network for the Proton download"; exit 1; }
  curl -fsSL --retry 5 --retry-all-errors -C - -o "$file" "$url" &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    size=$(stat -c %s "$file" 2>/dev/null || echo 0)
    echo "@@ $((58 + size * 36 / PROTON_SIZE)) Downloading Proton ($((size / 1048576)) of $((PROTON_SIZE / 1048576)) MB)"
    sleep 2
  done
  wait "$pid" || { sleep 5; rm -f "$file"; }
done
echo "$PROTON_SHA256  $file" | sha256sum -c --quiet || { echo "Proton download failed its checksum"; rm -f "$file"; exit 1; }
echo "@@ 95 Unpacking Proton"
rm -rf "$dest/$PROTON_NAME.part"
mkdir -p "$dest/$PROTON_NAME.part"
tar --zstd -xf "$file" -C "$dest/$PROTON_NAME.part"
# the archive holds one top-level directory
mv "$dest/$PROTON_NAME.part"/* "$dest/$PROTON_NAME"
rmdir "$dest/$PROTON_NAME.part"
rm -f "$file"
echo "== installed $PROTON_NAME"
