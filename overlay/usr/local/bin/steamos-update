#!/bin/bash
# Steam (-steamos3) OS update hook (System > Software Updates): exit 0 = update available / done, 7 = none.
# Interface from ChimeraOS gamescope-session-steam (MIT). The work is in mdeck-update.
[ "$(id -u)" = 0 ] || exec sudo -n /usr/local/sbin/mdeck-update steamos "$@"
exec /usr/local/sbin/mdeck-update steamos "$@"
