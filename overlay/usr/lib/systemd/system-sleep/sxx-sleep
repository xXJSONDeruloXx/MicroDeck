#!/bin/sh
# systemd-sleep hook (s2idle).
#  - Steam's virtual Deck controller is a USB/IP device on vhci_hcd, and that host controller refuses to suspend while a device is
#    attached: stop InputPlumber (which owns it) before sleeping and start it again on resume.
#  - The SDIO Wi-Fi chip is unbound before sleeping and bound again after, instead of trusting the driver's own suspend and resume;
#    NetworkManager reconnects when wlan0 returns.
#   sxx-sleep pre|post suspend
STATE=/run/sxx-sleep-sdio
case "$1" in
  pre)
    logger -t sxx-sleep "going to sleep"
    rm -f /run/sxx-sleep-woke "$STATE"
    systemctl stop inputplumber
    for dev in /sys/bus/sdio/devices/*; do
      [ -e "$dev/driver" ] || continue
      drv=$(basename "$(readlink "$dev/driver")")
      echo "$(basename "$dev") $drv" >> "$STATE"
      echo "$(basename "$dev")" > "$dev/driver/unbind"
    done
    sync
    ;;
  post)
    logger -t sxx-sleep "woke up"
    # The press that woke the handheld arrives as a power-key event right after resume; without this it would put it to sleep again.
    systemd-run --no-block --quiet --unit=sxx-sleep-holdoff \
      systemd-inhibit --what=handle-power-key --who=sxx-sleep --why="just woke up" --mode=block sleep 3
    # in the background, so the resume is not held up
    [ -f "$STATE" ] && systemd-run --no-block --quiet --unit=sxx-sleep-wifi /usr/local/sbin/sxx-sleep-wifi
    systemctl start inputplumber
    touch /run/sxx-sleep-woke
    ;;
esac
exit 0
