#!/bin/busybox sh
# Debug initramfs: logs the boot to the STEAMBOOT FAT partition, then switches to the real root.
# Each boot writes bootlog-N.txt; read it later from muOS (/mnt/sdcard when the card is in slot 2).
/bin/busybox --install -s /bin
export PATH=/bin
mkdir -p /proc /sys /dev /mnt/boot /mnt/root
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev

boot=
for i in $(seq 1 40); do
  boot=$(findfs LABEL=STEAMBOOT 2>/dev/null) && break
  sleep 0.5
done
if [ -n "$boot" ] && mount -t vfat -o rw,sync "$boot" /mnt/boot; then
  n=0; while [ -e /mnt/boot/bootlog-$n.txt ]; do n=$((n + 1)); done
  log=/mnt/boot/bootlog-$n.txt
else
  log=/dev/kmsg
fi
note() { echo "debug-init: $*" >> "$log"; echo "debug-init: $*" > /dev/kmsg; sync; }

note "reached initramfs, uptime $(cut -d' ' -f1 /proc/uptime)s, boot partition $boot"
note "cmdline: $(cat /proc/cmdline)"
note "block devices: $(ls /sys/class/block | tr '\n' ' ')"
note "panels/drm: $(ls /sys/class/drm 2>/dev/null | tr '\n' ' ') backlight: $(ls /sys/class/backlight 2>/dev/null)"
note "udc: $(ls /sys/class/udc 2>/dev/null)  net: $(ls /sys/class/net | tr '\n' ' ')"

# OS update staged by sxx-update (on the data partition): write the new root over the old one, then the new boot files.
# Nothing is mounted from the root yet, so it can be overwritten; if power fails midway, "pending" is still there and the
# next boot does it again. The boot files go last, each through a temporary name and a rename.
show() { echo "$*" > /dev/tty0 2>/dev/null; note "$*"; }
data=$(findfs LABEL=sxxdata 2>/dev/null)
u=/mnt/data/.sxx/update
if [ -n "$boot" ] && [ -n "$data" ] && mkdir -p /mnt/data && mount -t ext4 -o rw "$data" /mnt/data 2>/dev/null; then
  # A freshly installed release is on trial until the system marks it good (sxx-update good, once Steam's UI has been up
  # for a while). Boots that never get there are counted; after three, the previous release is installed again.
  # recovery.txt on the boot partition (writable from any PC) with a line "sxx=previous" asks for the previous release now.
  force=0
  if [ -f /mnt/boot/recovery.txt ] && grep -q '^sxx=previous' /mnt/boot/recovery.txt; then
    mv /mnt/boot/recovery.txt /mnt/boot/recovery.txt.used; sync
    force=1
    [ -f $u/previous/root.img ] || show "recovery.txt asks for the previous release, but none is kept: flash the image again"
  fi
  if { [ -f $u/trial ] || [ $force = 1 ]; } && [ ! -f $u/pending ]; then
    t=$(( $(cat $u/trial 2>/dev/null || echo 0) + 1 )); [ $force = 1 ] && t=99; [ -f $u/trial ] && echo $t > $u/trial; sync
    if [ $t -gt 3 ] && [ -f $u/previous/root.img ] && [ -d $u/previous/boot ]; then
      show "SteamOSXX $(cat $u/installed/tag 2>/dev/null) is being replaced by $(cat $u/previous/tag)"
      cp $u/installed/tag $u/bad 2>/dev/null
      rm -rf $u/root.img $u/boot
      mv $u/previous/root.img $u/root.img; mv $u/previous/boot $u/boot; cp $u/previous/tag $u/pending
      rm -rf $u/previous $u/installed; rm -f $u/trial $u/tries; sync
    fi
  fi
fi
if [ -f $u/pending ] && [ -f $u/root.img ] && [ -d $u/boot ] && grep -q ' /mnt/data ' /proc/mounts; then
  tries=$(cat $u/tries 2>/dev/null || echo 0)
  echo $((tries + 1)) > $u/tries; sync
  newroot=${boot%1}2
  if [ "$tries" -ge 3 ]; then
    show "update $(cat $u/pending) failed $tries times, giving up"
    rm -f $u/pending
  elif [ -b "$newroot" ]; then
    show "Installing SteamOSXX $(cat $u/pending). Do not power off."
    # the release being replaced, read before it is overwritten: only an image of that release is a valid rollback target
    oldrel=; mkdir -p /mnt/oldroot
    if mount -t ext4 -o ro,noload "$newroot" /mnt/oldroot 2>/dev/null; then oldrel=$(cat /mnt/oldroot/etc/sxx-release 2>/dev/null); umount /mnt/oldroot; fi
    mb=$(( $(stat -c %s $u/root.img) / 1048576 )); i=0; ok=1
    while [ $i -lt $mb ]; do
      dd if=$u/root.img of=$newroot bs=1M skip=$i seek=$i count=64 conv=notrunc status=none 2>>"$log" || ok=0
      i=$((i + 64))
      echo "SteamOSXX update: $((i * 100 / mb)) %" > /dev/tty0 2>/dev/null
    done
    sync
    if [ $ok = 1 ]; then
      ( cd $u/boot && find . -type f ) | while read -r f; do
        case "$f" in ./extlinux/*|./KERNEL) continue;; esac
        mkdir -p "/mnt/boot/$(dirname "$f")"; cp "$u/boot/$f" "/mnt/boot/$f.new" && mv "/mnt/boot/$f.new" "/mnt/boot/$f"
      done
      cp $u/boot/KERNEL /mnt/boot/KERNEL.new && sync && mv /mnt/boot/KERNEL.new /mnt/boot/KERNEL
      cp $u/boot/extlinux/extlinux.conf /mnt/boot/extlinux/extlinux.conf.new && sync && mv /mnt/boot/extlinux/extlinux.conf.new /mnt/boot/extlinux/extlinux.conf
      sync
      show "SteamOSXX $(cat $u/pending) installed, restarting"
      # keep what was just installed (the rollback target of the next update) and put the release on trial
      rm -rf $u/previous
      if [ -d $u/installed ] && [ "$(cat $u/installed/tag 2>/dev/null)" = "$oldrel" ]; then mv $u/installed $u/previous; else rm -rf $u/installed; fi
      mkdir -p $u/installed && mv $u/root.img $u/installed/root.img && mv $u/boot $u/installed/boot && cp $u/pending $u/installed/tag
      echo 0 > $u/trial; rm -f $u/pending $u/tries $u/latest.json; sync
      umount /mnt/data; umount /mnt/boot; sync
      reboot -f
    fi
    show "update write failed, see the boot log"
  fi
fi
umount /mnt/data 2>/dev/null

root=
for i in $(seq 1 40); do
  root=$(findfs LABEL=steamroot 2>/dev/null) && break
  sleep 0.5
done
note "root device: ${root:-not found}"
dmesg >> "$log"; sync

if [ -z "$root" ] || ! mount -t ext4 -o rw "$root" /mnt/root; then
  note "root mount failed; dmesg follows, rebooting in 20 s"
  dmesg >> "$log"; sync
  sleep 20
  reboot -f
fi
note "root mounted; init is $(ls -l /mnt/root/lib/systemd/systemd 2>&1)"

note "switching root"
umount /mnt/boot 2>/dev/null
mount --move /dev /mnt/root/dev 2>/dev/null
umount /proc /sys 2>/dev/null
exec switch_root /mnt/root /lib/systemd/systemd
